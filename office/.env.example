# Copy variable names into your own Vercel project's server-side environment settings.
# This file contains placeholders only. Never commit real values.
VILLAGE_OFFICE_NAME=My Village
VILLAGE_PROVIDER=openai
OPENAI_API_KEY=replace-in-vercel-secret-settings
# Or choose Anthropic and set ANTHROPIC_API_KEY as a Vercel secret.
OFFICE_ALLOWED_ORIGINS=https://your-office.example.com
OFFICE_ALLOWED_EMAILS=you@example.com
VILLAGE_GITHUB_REPO=your-user/your-repo
GITHUB_ISSUES_TOKEN=replace-in-vercel-secret-settings
VERCEL_APP_CLIENT_ID=your-app-client-id
VERCEL_APP_CLIENT_SECRET=replace-in-vercel-secret-settings
OFFICE_SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes
