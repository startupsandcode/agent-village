# Copy variable names into your own Vercel project's server-side environment settings.
# This file contains placeholders only. Never commit real values.
VILLAGE_OFFICE_NAME=My Village
VILLAGE_PROVIDER=openai
OPENAI_API_KEY=replace-in-vercel-secret-settings
# Or choose Anthropic and set ANTHROPIC_API_KEY as a Vercel secret.
OFFICE_ALLOWED_ORIGINS=https://your-office.example.com
OFFICE_ALLOWED_EMAILS=you@example.com
OFFICE_RUN_ALLOWED_EMAILS=you@example.com
VILLAGE_DATABASE_URL=replace-in-vercel-secret-settings
# Enable only after applying the schema and verifying the database and provider.
# VILLAGE_HOSTED_RUNS_ENABLED=true
VILLAGE_GITHUB_REPO=your-user/your-repo
GITHUB_ISSUES_TOKEN=replace-in-vercel-secret-settings
# Optional hosted publishing. Set only in a protected Preview after selecting
# separate, dedicated destinations. Publishing stays unavailable without them.
# VILLAGE_PUBLISH_GITHUB_TOKEN=single-repository-contents-write-token
# VILLAGE_PUBLISH_GITHUB_OWNER=your-user
# VILLAGE_PUBLISH_GITHUB_REPO=your-dedicated-private-site-repo
# VILLAGE_PUBLISH_GITHUB_BRANCH=village-publish
# VILLAGE_PUBLISH_GITHUB_DEDICATED_REPO_CONFIRMED=true
# VILLAGE_PUBLISH_VERCEL_TOKEN=team-scoped-token
# VILLAGE_PUBLISH_VERCEL_TEAM=your-team-slug
# VILLAGE_PUBLISH_VERCEL_PROJECT=your-dedicated-static-site-project
VERCEL_APP_CLIENT_ID=your-app-client-id
VERCEL_APP_CLIENT_SECRET=replace-in-vercel-secret-settings
OFFICE_SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes
