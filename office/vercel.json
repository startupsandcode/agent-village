{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/setup", "destination": "/setup.html" },
    { "source": "/office", "destination": "/api/private-page" },
    { "source": "/api/maya-artifacts/:id/:file", "destination": "/api/maya-projects?id=:id&file=:file" }
  ],
  "functions": {
    "api/private-page.mjs": { "includeFiles": "private/index.html" }
  }
}
