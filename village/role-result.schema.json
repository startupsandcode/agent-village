{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "stage", "status", "issue", "pr", "question_id", "question", "category", "evidence", "reviewed_sha"],
  "properties": {
    "request_id": {"type": "string", "pattern": "^maya:[1-9][0-9]*:[0-9a-f]{12}$"},
    "stage": {"enum": ["maya", "sam", "quinn"]},
    "status": {"enum": ["progress", "needs_owner", "needs_john", "ready_for_review", "blocked", "done"]},
    "issue": {"type": "integer", "minimum": 1},
    "pr": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
    "question_id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "question": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "category": {"enum": ["routine", "scope", "spend", "outreach", "data", "access", "release_blocker"]},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "reviewed_sha": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{40}$"}, {"type": "null"}]}
  }
}
